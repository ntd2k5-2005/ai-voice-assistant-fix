RUNTIME_PROFILE=local-balanced
MODEL_MANIFEST_ID=eureka-v10-source-baseline
STT_BASE_URL=http://127.0.0.1:8100
RAG_BASE_URL=http://127.0.0.1:8101
LLM_BASE_URL=http://127.0.0.1:8102
TTS_BASE_URL=http://127.0.0.1:8103

STT_TIMEOUT_S=180
RAG_TIMEOUT_S=180
LLM_TIMEOUT_S=240
TTS_TIMEOUT_S=240

RAG_MODE=dense
RAG_RERANK=false
RAG_TOP_K=5
RAG_CANDIDATE_K=50
RAG_REQUIRE_RERANK_APPLIED=true

LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=300
MAX_HISTORY_TURNS=3

TTS_VOICE_INDEX=2
TTS_SAMPLE_RATE=48000
TTS_CHANNELS=1
TTS_DTYPE=float32
TTS_GENERATION_MODE=stream
TTS_STREAM_CHUNK_MS=250
TTS_SENTENCE_QUEUE_MAX=4
TTS_AUDIO_QUEUE_MAX=12

# V10 AudioWorklet buffering. Initial buffer reduces startup risk; after a real
# underrun, rebuffer waits for a fresh cushion before resuming playback.
BROWSER_AUDIO_PREBUFFER_MS=700
BROWSER_AUDIO_REBUFFER_MS=900

# Legacy V6/V7 compatibility settings only.
TTS_PLAYBACK_CHUNK_MS=1000
TTS_PLAYBACK_MIN_CHUNK_MS=500
TTS_STARTUP_BUFFER_MS=650
TTS_STARTUP_BUFFER_MIN_MS=400
TTS_STARTUP_BUFFER_MAX_MS=1600
TTS_STARTUP_MAX_WAIT_MS=750
TTS_MAX_BUFFER_AHEAD_MS=5000
TTS_PHRASE_MIN_CHARS=24
TTS_PHRASE_SOFT_CHARS=220
TTS_PHRASE_HARD_CHARS=360
TTS_TRIM_SILENCE=true
TTS_SILENCE_THRESHOLD=0.002
TTS_LEADING_SILENCE_MS=35
TTS_TRAILING_SILENCE_MS=70
TTS_INTER_SENTENCE_PAUSE_MS=45

TTS_REJECT_ALL_SILENCE=true
TTS_OUTPUT_DIR=/tmp/voice_app_audio
TTS_KEEP_LAST_FILES=50

DEMO_HOST=0.0.0.0
DEMO_PORT=7860
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8010

TTS_FIRST_UNIT_MIN_CHARS=36
TTS_FIRST_UNIT_TARGET_CHARS=68
TTS_FIRST_UNIT_MAX_CHARS=104
TTS_STEADY_UNIT_MIN_CHARS=64
TTS_STEADY_UNIT_TARGET_CHARS=124
TTS_STEADY_UNIT_MAX_CHARS=176
